# Copy to .env.local and fill in. Never commit the real file.
#
# Only these values ever reach the browser. The publishable key begins with
# sb_publishable_. An sb_secret_ key, service_role JWT, database password or
# management token must never appear here.
#
# Server-side secrets belong in the Supabase secret store. See
# supabase/VERIFICATION.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional
VITE_TURNSTILE_SITE_KEY=
VITE_SITE_ORIGIN=
